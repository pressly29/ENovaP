# Copy to deploy/droplet/.env on the droplet and fill in. NEVER commit .env —
# this repo is public. (.env is already gitignored.)

# --- Site -------------------------------------------------------------------
# Apex domain the site is served on. Create DNS A records for DOMAIN and
# www.DOMAIN pointing at the droplet's IP. To test before DNS is moved, use
# <droplet-ip>.sslip.io (e.g. 203.0.113.10.sslip.io) — it resolves to the IP
# and still gets a real HTTPS certificate.
DOMAIN=evpnova.com
# Let's Encrypt expiry notices go here.
ACME_EMAIL=you@example.com

# Git branch deploy.sh builds from.
DEPLOY_BRANCH=dev

# --- Frontend build (public: baked into the JS bundle) -----------------------
# From your OAuth app on https://developers.deriv.com (see deploy/droplet/README.md
# "Deriv app"). Both are public identifiers, not secrets.
OAUTH_CLIENT_ID=
DERIV_APP_ID=
# Deriv partner tracking added to sign-ups (EvPNova's affiliate token).
REACT_APP_AFFILIATE_TOKEN=
REACT_APP_AFFILIATE_CAMPAIGN=
REACT_APP_AFFILIATE_SOURCE=
# Admin dashboard lives at /clients-analysis-<this> (open it with ?k=<ADMIN_ANALYTICS_TOKEN>).
REACT_APP_ADMIN_DASH_PATH=dash
# Optional: bot builder Google Drive save/load.
GD_CLIENT_ID=
GD_API_KEY=
GD_APP_ID=
# Defaults to "production" (minified). Set "development" to debug a build.
BUILD_NODE_ENV=

# --- Functions (server-side secrets) ------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=USD
ADMIN_ANALYTICS_TOKEN=
COMPANY_RECEIPT_EMAIL=
RESEND_API_KEY=
RECEIPT_FROM_EMAIL=
