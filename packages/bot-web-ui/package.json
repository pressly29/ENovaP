        "@deriv/bot-skeleton": "^1.0.0",
        "@deriv/components": "^1.0.0",
        "@deriv/shared": "^1.0.0",
        "@deriv/stores": "^1.0.0",
        "@deriv/trader": "^3.8.0",
        "classnames": "^2.2.6",
        "crc-32": "^1.2.0",
        "formik": "^2.1.4",
        "immutable": "^3.8.2",
        "lodash.debounce": "^4.0.8",
        "lz-string": "^1.4.4",
        "mobx": "^6.6.1",
        "mobx-react": "^7.5.1",
        "pako": "^1.0.11",
        "prop-types": "^15.7.2",
        "react": "^18.2.0",
